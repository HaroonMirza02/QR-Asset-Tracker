# ─────────────────────────────────────────────────────────────────────────────
# QR Asset Tracker — Environment Variables
# Copy this file to .env and fill in every value before starting the server.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection string.
# For local dev: mongodb://localhost:27017/qr-asset-tracker
# For Atlas:     mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/qr-asset-tracker

# Secret used to sign and verify JWTs. Must be a long, random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# JWT expiry in seconds. Default 86400 = 24 hours.
JWT_EXPIRES_IN=86400

# Port the Express server listens on.
PORT=3000

# Public base URL of the application (no trailing slash).
# Used to construct QR code scan URLs: <APP_BASE_URL>/scan/<qrToken>?t=<tenantId>
# In dev this is typically http://localhost:3000 or your frontend dev server URL.
APP_BASE_URL=http://localhost:3000

# Node environment. Use "test" when running Jest so the DB connection uses
# the test database and logging is suppressed.
# Values: development | production | test
# IMPORTANT: Set this to "development" (or unset it) before running the
#            server or seed script. If it is "test", the server connects
#            to MONGODB_URI_TEST, not MONGODB_URI.
NODE_ENV=development

# ─── Test-only ───────────────────────────────────────────────────────────────
# Separate MongoDB database used during Jest runs.
# The test runner drops and recreates this database on each full run.
# Only required if you run tests locally.
MONGODB_URI_TEST=mongodb://localhost:27017/qr-asset-tracker-test

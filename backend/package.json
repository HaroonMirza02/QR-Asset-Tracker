{
  "name": "qr-asset-tracker-backend",
  "version": "1.0.0",
  "description": "Reusable B2B Asset Tracking Foundation — Node/Express/MongoDB backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "jest --runInBand --forceExit --testTimeout=30000",
    "test:coverage": "jest --runInBand --forceExit --coverage --testTimeout=30000",
    "acceptance": "node src/scripts/acceptance.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.4.1",
    "qrcode": "1.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "3.1.3",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "dotenv/config"
    ]
  }
}
